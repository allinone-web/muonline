{
  "DiagnosticsServer": {
    "PipeName": "muonline-diagnostics-v1",
    "HistoryMinutes": 30,
    "MaxEvents": 1000,
    "OpenBrowserOnStart": true,
    "DashboardUrl": "http://127.0.0.1:5078"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5078"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
