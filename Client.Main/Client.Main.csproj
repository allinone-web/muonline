<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ClientMainTargetFramework>net10.0</ClientMainTargetFramework>
    <ClientMainTargetFramework Condition="'$(MonoGameFramework)' == 'MonoGame.Framework.WindowsDX'">net10.0-windows</ClientMainTargetFramework>
    <TargetFramework>$(ClientMainTargetFramework)</TargetFramework>
    <AssemblyName>Client.Main</AssemblyName>
    <RootNamespace>Client.Main</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseSourceGenerators>true</UseSourceGenerators>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MonoGameFramework)' == 'MonoGame.Framework.WindowsDX'">
    <DefineConstants>$(DefineConstants);WINDOWS_DX</DefineConstants>
  </PropertyGroup>

  <!--
    Client.Main 原始碼裡曾經有多處 #if IOS / #if !IOS，但那個符號在這裡
    <b>從來沒有生效過</b>：.NET SDK 為 net10.0-ios 定義的是 __IOS__（Xamarin 慣例），
    而 IOS 只有 MuIos.csproj 自己加；Client.Main 又是以 net10.0 建置的
    （見上面的 ClientMainTargetFramework，MuIos 設的同名屬性不會傳進來），
    所以下面這個條件永遠不成立。

    真正會出事的幾處（連線中斷後呼叫 Exit()、離開遊戲呼叫 Exit()、設定無效呼叫 Exit()）
    已經改成執行期判斷 MuGame.RequestExit()，不再依賴這個符號。
    這段保留是為了讓「以 net10.0-ios 建置 Client.Main」的組態仍然正確。
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <DefineConstants>$(DefineConstants);IOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MonoGamePlatform)' == 'WindowsDX12'">
    <DefineConstants>$(DefineConstants);WINDOWS_DX;WINDOWS_DX12;NATIVE_BACKEND</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MonoGamePlatform)' == 'DesktopVK'">
    <DefineConstants>$(DefineConstants);DESKTOP_VK;NATIVE_BACKEND</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pipelines.Sockets.Unofficial" Version="2.2.16" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>

  <!--
    OpenMU 網路函式庫：優先用旁邊 openmu fork 裡的 ClientOnly 專案，沒有才退回 NuGet。

    兩者的公開型別與命名空間完全一樣（ClientOnly 就是同一份原始碼），
    差別只在 ClientOnly 排掉了 Network/PlugIns/ 以及對 MUnique.OpenMU.PlugIns 的參考。
    PlugIns 為了在執行期產生外掛代理而相依 Roslyn（Microsoft.CodeAnalysis.CSharp），
    伺服器需要，客戶端一行都沒用到 —— 但在 iOS 上，相依就等於打包：
    AOT 會把整個 Roslyn 編成原生碼。實測 MuIos.app 從 285 MB 降到 181 MB，
    原生執行檔從 157.8 MB 降到 91.3 MB。

    退回 NuGet 的路徑仍然可以正常編譯與執行，只是 app 會大 104 MB。
    保留它是為了讓 muonline 這個 repo 單獨 clone 時依然能建置。
    詳見 repos/openmu/src/ClientOnly/README.md。
  -->
  <PropertyGroup>
    <!-- OpenMuRepoDir 可以從外面覆寫（-p:OpenMuRepoDir=... 或同名環境變數）。
         必須可覆寫：tools/client/run_iphone-air.sh 的 committed 模式會在
         /private/tmp/mu-stable 開 worktree 建置，那裡的相對路徑指不到 openmu。
         （XML 註解裡不能出現兩個連續的減號，所以旗標名稱這裡只寫 committed。） -->
    <OpenMuRepoDir Condition="'$(OpenMuRepoDir)' == ''">$(MSBuildThisFileDirectory)..\..\openmu\</OpenMuRepoDir>
    <OpenMuClientOnlyDir>$(OpenMuRepoDir)src\ClientOnly\</OpenMuClientOnlyDir>
    <HasOpenMuClientOnly Condition="Exists('$(OpenMuClientOnlyDir)Packets\MUnique.OpenMU.Network.Packets.ClientOnly.csproj')">true</HasOpenMuClientOnly>
  </PropertyGroup>

  <!-- 退回 NuGet 不會有任何錯誤，只是 app 大 104 MB —— 那正是最難察覺的失敗。
       行動端建置時明講一聲。 -->
  <Target Name="WarnOpenMuFallback" BeforeTargets="ResolveReferences"
          Condition="'$(HasOpenMuClientOnly)' != 'true' AND ('$(TargetFramework)' == 'net10.0-ios' OR '$(TargetFramework)' == 'net10.0-android')">
    <Warning Text="找不到 $(OpenMuClientOnlyDir)，改用 NuGet 的 MUnique.OpenMU.Network。這會讓 app 多出約 104 MB 的 Roslyn 相關內容。用 -p:OpenMuRepoDir= 指到 openmu fork 即可避免。" />
  </Target>

  <ItemGroup Condition="'$(HasOpenMuClientOnly)' == 'true'">
    <ProjectReference Include="$(OpenMuClientOnlyDir)Network\MUnique.OpenMU.Network.ClientOnly.csproj" />
    <ProjectReference Include="$(OpenMuClientOnlyDir)Packets\MUnique.OpenMU.Network.Packets.ClientOnly.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasOpenMuClientOnly)' != 'true'">
    <PackageReference Include="MUnique.OpenMU.Network" Version="0.9.8" />
    <PackageReference Include="MUnique.OpenMU.Network.Packets" Version="0.9.8" ExcludeAssets="contentFiles" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' AND '$(MonoGameFramework)' == 'MonoGame.Framework.Native'">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' AND '$(MonoGameFramework)' == 'MonoGame.Framework.WindowsDX'">
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android' AND '$(MonoGameFramework)' != 'MonoGame.Framework.Native' AND '$(MonoGameFramework)' != 'MonoGame.Framework.WindowsDX'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Controls\UI\Game\Layouts\*.json" />
    <EmbeddedResource Include="Data\S6\item.bmd" />
    <EmbeddedResource Include="Data\S6\mix.bmd" />
    <EmbeddedResource Include="Data\S6\movereq_eng.bmd" />
    <EmbeddedResource Include="Data\S6\player.bmd" />
    <EmbeddedResource Include="Data\S6\skill_eng.bmd" />
    <EmbeddedResource Include="Data\bmd_blending_config.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Data\Client.Data.csproj" />
    <ProjectReference Include="..\Client.Telemetry\Client.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
