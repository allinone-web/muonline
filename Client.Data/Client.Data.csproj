<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 兩個目標框架：
           net10.0  本專案的工具鏈與 MonoGame 客戶端
           net8.0   Godot 4.3 的上限 —— 地圖編輯器要轉去 Godot，那邊必須引用得到這份解析。
         解析只有一份，不會為了引擎再抄一份（RealmForge 就是因為讀中立包才沒有第二份解析）。
         消費端可以覆寫成單一值（iOS 建置就這樣做），所以用 TargetFrameworks 但保留原本的屬性名。 -->
    <ClientDataTargetFramework Condition="'$(ClientDataTargetFramework)'==''">net10.0;net8.0</ClientDataTargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TargetFrameworks>$(ClientDataTargetFramework)</TargetFrameworks>
    <AssemblyName>Client.Data</AssemblyName>
    <RootNamespace>Client.Data</RootNamespace>
    <UseSourceGenerators>true</UseSourceGenerators>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="BouncyCastle.NetCore" Version="2.2.1" />
    <PackageReference Include="cryptopp" Version="5.6.5.4" />
    <PackageReference Include="Delizious.Ini" Version="1.20.0" />
    <PackageReference Include="LEA.NET" Version="1.0.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- 資源庫的自有資產是 glTF；GltfImporter 在 Assets/ 底下。 -->
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
  </ItemGroup>
</Project>
